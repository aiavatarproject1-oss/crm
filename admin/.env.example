# Laravel API (no trailing /api — the client already prefixes /api/v1/...)
# Local:     http://localhost:8000
# Via ngrok: https://resale-displace-banker.ngrok-free.dev
NEXT_PUBLIC_API_URL=https://resale-displace-banker.ngrok-free.dev

NEXT_PUBLIC_REVERB_KEY=change-me-key
# Local websocket:  localhost / 8080 / http
# Via ngrok:        resale-displace-banker.ngrok-free.dev / 443 / https
NEXT_PUBLIC_REVERB_HOST=resale-displace-banker.ngrok-free.dev
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
